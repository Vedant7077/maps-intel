    },
    {
      "parameters": {
        "mode": "append",
        "options": {}
      },
      "id": "940fcb4c-2579-49e3-8445-506ebaa921ae",
      "name": "Merge: Trends + History",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        240,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const trendsResult = $('Postgres: Get Top Trends').all().map(i => i.json);\nconst historyResult = $('Postgres: Get Idea History').all().map(i => i.json.topic_title);\nconst count = Number($('Webhook: /generate-ideas').item.json.body.count || 5);\nconst projectId = $('Webhook: /generate-ideas').item.json.body.project_id;\n\nconst trendsList = trendsResult.map(t => `- ${t.topic} (${t.percentage}% of competitor posts)`).join('\\n') || 'No trend data yet — generate general small-business content ideas.';\nconst historyList = historyResult.length ? historyResult.join('; ') : 'none yet';\n\nconst prompt = `You are a local marketing assistant. Based on these competitor content trends:\\n${trendsList}\\n\\nGenerate ${count} NEW Google Maps post ideas for our client business. DO NOT repeat or closely rephrase any of these previously generated titles: ${historyList}.\\n\\nReturn ONLY a valid JSON array (no markdown, no preamble) where each item has exactly this shape:\\n{\"topic_title\": string, \"post_copy\": string (160-300 characters), \"keywords\": string[], \"cta_type\": one of [call, visit, book, buy, learn], \"cta_text\": string, \"image_concept\": string}`;\n\nreturn { json: { prompt, project_id: projectId, count } };"
      },
      "id": "4ed0640a-32a2-4508-8f02-5a30f8fb8e9d",
      "name": "Code: Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-lite-latest:generateContent?key={{ $env.GEMINI_API_KEY }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ text: $json.prompt }] }], generationConfig: { temperature: 0.8, responseMimeType: 'application/json' } }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "9b6d2efe-0fca-4bb3-baad-b2f8c17313d6",
      "name": "HTTP: Gemini Generate Ideas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.item.json;\nlet text = raw.candidates[0].content.parts[0].text;\ntext = text.replace(/```json|```/g, '').trim();\nlet ideas;\ntry {\n  ideas = JSON.parse(text);\n  if (!Array.isArray(ideas)) ideas = [ideas];\n} catch (e) {\n  ideas = [];\n}\nreturn ideas.map(idea => ({ json: idea }));"
      },
      "id": "1773aefd-9070-4847-a008-efa050aeea61",
      "name": "Code: Parse Ideas Array",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        80
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO generated_ideas (id, project_id, topic_title, post_copy, keywords, cta_type, cta_text, image_concept, ai_provider, generated_at, used)\nVALUES (\n  gen_random_uuid()::text,\n  '{{ $('Webhook: /generate-ideas').item.json.body.project_id }}',\n  '{{ $json.topic_title.replace(/'/g, \"''\") }}',\n  '{{ $json.post_copy.replace(/'/g, \"''\") }}',\n  '{{ JSON.stringify($json.keywords || []) }}'::jsonb,\n  '{{ $json.cta_type }}',\n  '{{ ($json.cta_text || '').replace(/'/g, \"''\") }}',\n  '{{ ($json.image_concept || '').replace(/'/g, \"''\") }}',\n  'gemini',\n  NOW(),\n  false\n)\nRETURNING *",
        "options": {}
      },
      "id": "1b82658d-c54c-4105-b6bf-371a6c802d67",
      "name": "Postgres: Save Idea",
