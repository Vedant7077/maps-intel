    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT topic, percentage FROM trend_snapshots\nWHERE project_id = '{{ $json.body.project_id }}'\nORDER BY percentage DESC LIMIT 10",
        "options": {}
      },
      "id": "483faa5d-ece9-4e7d-9e47-f1ec9dc7fb4f",
      "name": "Postgres: Get Top Trends",
      "type": "n8n-nodes-base.postgres",
