      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT topic_title FROM generated_ideas\nWHERE project_id = '{{ $('Webhook: /generate-ideas').item.json.body.project_id }}'\nORDER BY generated_at DESC LIMIT 30",
        "options": {}
      },
      "id": "a6505e77-44a8-4295-a1e5-b956ca47ae48",
      "name": "Postgres: Get Idea History",
      "type": "n8n-nodes-base.postgres",
