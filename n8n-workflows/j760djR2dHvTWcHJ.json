    {
      "parameters": {
        "operation": "executeQuery",
        "query": "DELETE FROM trend_snapshots WHERE project_id = $1;",
        "options": {
          "queryReplacement": "={{ $json.body.project_id }}"
        }
      },
      "id": "64e2130a-7097-4c02-8637-52e7fa250619",
      "name": "Postgres: Clear Old Snapshots",
      "type": "n8n-nodes-base.postgres",
