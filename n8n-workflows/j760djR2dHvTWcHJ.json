        240,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "HOXKPRGYkGAfzqmj",
          "name": "MapsPy Postgres"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  p.main_topic AS topic,\n  COUNT(DISTINCT p.competitor_id) AS competitor_count,\n  COUNT(*) AS occurrence_count\nFROM posts p\nJOIN competitors c ON c.id = p.competitor_id\nWHERE p.project_id = $1\nAND p.main_topic IS NOT NULL\nAND c.is_client = false\nGROUP BY p.main_topic\nORDER BY occurrence_count DESC",
        "options": {
          "queryReplacement": "={{ $('Webhook: /aggregate-trends').item.json.body.project_id }}"
        }
      },
      "id": "226339d5-1d86-42bd-9de9-53fd7fb96aae",
      "name": "Postgres: Group By Topic",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        480,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "HOXKPRGYkGAfzqmj",
          "name": "MapsPy Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst total = items.reduce((sum, i) => sum + Number(i.json.occurrence_count), 0) || 1;\nreturn items.map(i => ({\n  json: {\n    ...i.json,\n    percentage: Math.round((Number(i.json.occurrence_count) / total) * 1000) / 10\n  }\n}));"
      },
      "id": "728ea364-9056-4e45-893b-98994e328fb8",
      "name": "Code: Calculate Percentage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO trend_snapshots (id, project_id, topic, competitor_count, occurrence_count, percentage, calculated_at)\nVALUES (gen_random_uuid()::text, $1, $2, $3, $4, $5, NOW())",
        "options": {
          "queryReplacement": "={{ [$('Webhook: /aggregate-trends').item.json.body.project_id, $json.topic, $json.competitor_count, $json.occurrence_count, $json.percentage] }}"
        }
      },
      "id": "306980b6-5b86-4277-965b-2649422c76cb",
      "name": "Postgres: Insert Snapshot",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        960,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "HOXKPRGYkGAfzqmj",
          "name": "MapsPy Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const allTopics = $input.all();\nconst projectId = $('Webhook: /aggregate-trends').item.json.body.project_id;\nreturn [{\n  json: {\n    project_id: projectId,\n    topic_count: allTopics.length\n  }\n}];"
      },
