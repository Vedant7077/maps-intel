          },
          "conditions": [
            {
              "leftValue": "={{ $json.candidates !== undefined }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b52b0a64-0852-4030-9878-2bd5df146e4b",
      "name": "IF: Gemini Succeeded",
