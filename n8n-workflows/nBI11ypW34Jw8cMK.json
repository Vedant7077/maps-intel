      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.GROK_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'x-ai/grok-4.3', messages: [{ role: 'user', content: `Classify this Google Maps update post. Return ONLY valid JSON: {\"main_topic\":string,\"sub_topic\":string,\"keywords\":string[],\"content_type\":string,\"cta_type\":string,\"has_promotion\":boolean,\"promotion_details\":string|null}. Post: ${$('Split In Batches (5)').item.json.post_text}` }], max_tokens: 1000, temperature: 0.1 }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "99afa43d-09eb-4f64-9e28-7c7f78623dba",
      "name": "HTTP: Grok Fallback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        272,
        288
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst batchItems = $('Split In Batches (5)').all();\n\nreturn items.map((item, index) => {\n  const raw = item.json;\n  let text = '';\n  if (raw.candidates && raw.candidates[0]?.content?.parts?.[0]?.text) {\n    text = raw.candidates[0].content.parts[0].text;\n  } else if (raw.choices && raw.choices[0]?.message?.content) {\n    text = raw.choices[0].message.content;\n  } else {\n    text = JSON.stringify(raw);\n  }\n  text = text.replace(/```json|```/g, '').trim();\n  let parsed;\n  try {\n    parsed = JSON.parse(text);\n  } catch (e) {\n    parsed = {\n      main_topic: 'Uncategorized',\n      sub_topic: null,\n      keywords: [],\n      content_type: 'announcement',\n      cta_type: 'none',\n      has_promotion: false,\n      promotion_details: null\n    };\n  }\n\n  const srcIdx = typeof item.pairedItem === 'number'\n    ? item.pairedItem\n    : (item.pairedItem?.item !== undefined ? item.pairedItem.item : index);\n  const sourceItem = batchItems[srcIdx]?.json || batchItems[index]?.json || {};\n\n  return {\n    json: {\n      ...parsed,\n      post_id: sourceItem.id || null,\n      project_id: sourceItem.project_id || null,\n      competitor_id: sourceItem.competitor_id || null\n    }\n  };\n});"
      },
      "id": "a973a24b-c142-4267-a70e-7cd53fc460bb",
      "name": "Code: Parse AI Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
