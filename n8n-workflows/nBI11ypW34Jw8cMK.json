    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-flash-lite-latest:generateContent?key={{ $env.GEMINI_API_KEY }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ text: `Classify this Google Maps business update post. Return ONLY valid JSON, no markdown, no preamble, matching exactly this shape: {\"main_topic\": string, \"sub_topic\": string, \"keywords\": string[], \"content_type\": one of [offer, tips, event, announcement, review_highlight], \"cta_type\": one of [call, visit, book, buy, learn, none], \"has_promotion\": boolean, \"promotion_details\": string or null}. Post text: ${$json.post_text}` }] }], generationConfig: { temperature: 0.1, responseMimeType: 'application/json' } }) }}",
        "options": {
          "timeout": 15000
        }
      },
